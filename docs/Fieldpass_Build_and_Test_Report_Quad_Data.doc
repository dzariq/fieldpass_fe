\pard\qc\b\f1\fs44 Fieldpass\par
\pard\qc\b\f1\fs32 Build, Deployment \& Internal Test Report\par
\pard\qc\fs24\par
\pard\qc\fs24 Prepared for:\b  Quad Data Sdn Bhd\b0\par
\pard\qc\fs24 Date:\b  06 May 2026\b0\par
