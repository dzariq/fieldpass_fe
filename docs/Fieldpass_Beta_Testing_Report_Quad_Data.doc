\pard\b\f1\fs32 4. Player Login Functions\b0\f0\fs24\par
\pard\b Scope\b0\par
\pard\li360\fs24\bullet\tab Player login page access\par
\pard\li360\fs24\bullet\tab OTP/password flow (as configured)\par
\pard\li360\fs24\bullet\tab Player dashboard access and session handling\par
\pard\li360\fs24\bullet\tab Logout and re-login behavior\par
\pard\fs24\par
\pard\b Test cases\b0\par
\pard\li360\fs24\bullet\tab Navigate to player login; page renders.\tab Result: ________\par
\pard\li360\fs24\bullet\tab Submit valid player credentials/OTP; login successful.\tab Result: ________\par
\pard\li360\fs24\bullet\tab Submit invalid OTP/credentials; appropriate error shown.\tab Result: ________\par
