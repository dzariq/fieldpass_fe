\pard\b 4.1 Deployment checklist\b0\par
\pard\li360\fs24\bullet\tab DNS points to droplet IP\par
\pard\li360\fs24\bullet\tab TLS certificate installed and auto-renew configured (if applicable)\par
\pard\li360\fs24\bullet\tab Firewall restricts inbound ports (80/443 + SSH)\par
\pard\li360\fs24\bullet\tab Environment variables reviewed and secured\par
\pard\li360\fs24\bullet\tab \i docker compose up -d --build\i0 successful\par
\pard\li360\fs24\bullet\tab Migrations run and verified\par
\pard\li360\fs24\bullet\tab Health checks passed\par
\pard\fs24\par

\pard\b 4.2 Internal test checklist\b0\par
\pard\li360\fs24\bullet\tab Login / logout\par
\pard\li360\fs24\bullet\tab Club dashboard loads for Club Manager\par
\pard\li360\fs24\bullet\tab Budget \& expenses visible and accessible\par
\pard\li360\fs24\bullet\tab Add / edit / delete expense flows\par
\pard\li360\fs24\bullet\tab Filter year/month\par
\pard\li360\fs24\bullet\tab Sort columns\par
\pard\li360\fs24\bullet\tab Unauthorized users cannot access budget routes (403)\par

